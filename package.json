{
  "name": "promach-dsr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ec2": "next build && node scripts/prepare-standalone.mjs",
    "generate:pdfs": "node --experimental-strip-types scripts/generate-sample-pdfs.ts",
    "seed": "node --experimental-strip-types scripts/seed-database.ts",
    "start": "node scripts/start.mjs",
