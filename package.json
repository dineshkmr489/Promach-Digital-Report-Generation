    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1121.0",
    "@aws-sdk/client-rds": "^3.1121.0",
    "@aws-sdk/client-secrets-manager": "^3.1121.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
