ADMIN_USERNAME=promach-admin
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=Promach Admin
ADMIN_EMAIL=admin@example.com

HOSTNAME=0.0.0.0
PORT=3000
